# ===== رصد Frontend — بناء إنتاجي متعدد المراحل =====
# المرحلة 1: بناء الواجهة الثابتة عبر Vite
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# VITE_API_BASE يُمرَّر كوسيط بناء عند الحاجة لخادم خلفي على نطاق آخر
ARG VITE_API_BASE=/api
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build

# المرحلة 2: خدمة الملفات الثابتة عبر nginx (خفيف، مع وكيل /api)
# الصورة غير المميّزة تعمل كمستخدم nginx وتستمع على 8080 بدل 80 (منفذ 80
# يتطلّب root). التعرّض للخارج يبقى على 3000 عبر ربط المنفذ في compose.
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
# مقتطف الترويسات يُدرَج من كل location — خارج conf.d كي لا يُحمَّل مرتين
COPY security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD wget -qO- http://localhost:8080/ >/dev/null 2>&1 || exit 1
CMD ["nginx", "-g", "daemon off;"]
