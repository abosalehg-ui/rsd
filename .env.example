# ╔══════════════════════════════════════════════════════════════╗
# ║   رصد (Rasad) — قالب المتغيّرات البيئية                        ║
# ╚══════════════════════════════════════════════════════════════╝
#
# طريقة الاستخدام:
#   1. انسخ هذا الملف إلى ".env" في نفس المجلّد:
#          cp .env.example .env          (لينكس/ماك)
#          copy .env.example .env        (ويندوز)
#   2. املأ المفاتيح أدناه بقيمك الشخصية (اتركها فارغة لتعطيل المصدر).
#   3. لا ترفع ملف .env إلى Git أبداً — فهو مُدرَج في .gitignore.
#
# ملاحظة أمنية: جميع المفاتيح شخصية بحسابك. لا تشاركها ولا تضعها في لقطات
# الشاشة أو الـ Issues. إن تسرّب مفتاح، أبطِله من لوحة المزوّد وأصدر بديلاً.


# ─────────────────────────────────────────────────────────────────
# NewsAPI  (اختياري — لتفعيل مصدر أخبار NewsAPI)
# ─────────────────────────────────────────────────────────────────
# من أين تجلبه:
#   1. سجّل حساباً مجانياً على:  https://newsapi.org/register
#   2. بعد التفعيل، انسخ المفتاح من:  https://newsapi.org/account
#   3. الصقه بعد علامة = أدناه (بدون مسافات ولا علامات اقتباس).
# إن تركته فارغاً يعمل التطبيق دونه (تبقى مصادر GDELT/RSS/UCDP فعّالة).
newsapi_key=


# ─────────────────────────────────────────────────────────────────
# OpenSky Network  (غير مطلوب — تتبّع الطيران يعمل عبر adsb.lol المجاني)
# ─────────────────────────────────────────────────────────────────
# محجوزة لتوسّع مستقبلي فقط. اتركها فارغة.
# للحصول عليها لاحقاً:  https://opensky-network.org/  →  Account → API Clients
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=


# ─────────────────────────────────────────────────────────────────
# قاعدة البيانات
# ─────────────────────────────────────────────────────────────────
# الافتراضي SQLite محلي — لا يحتاج تثبيت. غيّره فقط لو تستخدم خادماً خارجياً.
DATABASE_URL=sqlite+aiosqlite:///./rasad.db


# ─────────────────────────────────────────────────────────────────
# فواصل جمع البيانات (بالثواني) — قلّلها بحذر لتفادي حظر المزوّدين
# ─────────────────────────────────────────────────────────────────
GDELT_INTERVAL=900       # كل 15 دقيقة
NEWSAPI_INTERVAL=600     # كل 10 دقائق
RSS_INTERVAL=120         # كل دقيقتين
UCDP_INTERVAL=86400      # يومياً
ADSB_INTERVAL=30         # كل 30 ثانية (لا تنزل تحتها — حماية حصة adsb.lol)


# ─────────────────────────────────────────────────────────────────
# الخادم
# ─────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0     # استخدم 127.0.0.1 لقصر الوصول على الجهاز المحلي
BACKEND_PORT=8000


# ─────────────────────────────────────────────────────────────────
# أمن الشبكة — أصول CORS المسموح لها بمناداة الـ API (مفصولة بفواصل)
# ─────────────────────────────────────────────────────────────────
# أضِف نطاق واجهتك عند النشر، مثال:  https://username.github.io
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000


# ─────────────────────────────────────────────────────────────────
# سياسة الاحتفاظ بالبيانات (أيام) — تحذف الأقدم تلقائياً يومياً
# ─────────────────────────────────────────────────────────────────
RETENTION_EVENTS_DAYS=30
RETENTION_FLIGHTS_DAYS=7


# ─────────────────────────────────────────────────────────────────
# المرحلة 2 (غير مفعّلة — أزِل التعليق عند الجاهزية)
# ─────────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3-coder:30b
