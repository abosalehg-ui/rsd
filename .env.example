# ╔══════════════════════════════════════════════════════════════╗
# ║   رصد (Rasad) — قالب المتغيّرات البيئية                        ║
# ╚══════════════════════════════════════════════════════════════╝
#
# طريقة الاستخدام:
#   1. انسخ هذا الملف إلى ".env" في نفس المجلّد:
#          cp .env.example .env          (لينكس/ماك)
#          copy .env.example .env        (ويندوز)
#   2. املأ المفاتيح أدناه بقيمك الشخصية (اتركها فارغة لتعطيل المصدر).
#   3. لا ترفع ملف .env إلى Git أبداً — فهو مُدرَج في .gitignore.
#
# ملاحظة أمنية: جميع المفاتيح شخصية بحسابك. لا تشاركها ولا تضعها في لقطات
# الشاشة أو الـ Issues. إن تسرّب مفتاح، أبطِله من لوحة المزوّد وأصدر بديلاً.


# ─────────────────────────────────────────────────────────────────
# NewsAPI  (اختياري — لتفعيل مصدر أخبار NewsAPI)
# ─────────────────────────────────────────────────────────────────
# من أين تجلبه:
#   1. سجّل حساباً مجانياً على:  https://newsapi.org/register
#   2. بعد التفعيل، انسخ المفتاح من:  https://newsapi.org/account
#   3. الصقه بعد علامة = أدناه (بدون مسافات ولا علامات اقتباس).
# إن تركته فارغاً يعمل التطبيق دونه (تبقى مصادر GDELT/RSS/UCDP فعّالة).
newsapi_key=


# ─────────────────────────────────────────────────────────────────
# OpenSky Network  (غير مطلوب — تتبّع الطيران يعمل عبر adsb.lol المجاني)
# ─────────────────────────────────────────────────────────────────
# محجوزة لتوسّع مستقبلي فقط. اتركها فارغة.
# للحصول عليها لاحقاً:  https://opensky-network.org/  →  Account → API Clients
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=


# ─────────────────────────────────────────────────────────────────
# Google Alerts  (اختياري — خلاصات تنبيهات مخصّصة بحسابك)
# ─────────────────────────────────────────────────────────────────
# ⚠️ رابط خلاصة Google Alerts يحوي معرّف حسابك وهو سرّ شخصي — لا تضعه في
#    المصدر ولا تشاركه. من يملك الرابط يقرأ تنبيهاتك.
#
# من أين تجلبه:
#   1. افتح  https://www.google.com/alerts  وأنشئ تنبيهاً.
#   2. من "تسليم إلى" اختر  RSS feed  ثم انسخ رابط الخلاصة.
#
# الصيغة: عناصر مفصولة بفواصل، كل عنصر "الاسم|التصنيف|الرابط".
# التصنيفات المتاحة: military | nuclear | diplomatic | humanitarian | economic | general
# مثال (سطر واحد):
# GOOGLE_ALERT_FEEDS=GA - Red Sea|military|https://www.google.com/alerts/feeds/…,GA - Iran Nuclear|nuclear|https://www.google.com/alerts/feeds/…
GOOGLE_ALERT_FEEDS=


# ─────────────────────────────────────────────────────────────────
# قاعدة البيانات
# ─────────────────────────────────────────────────────────────────
# الافتراضي SQLite محلي — لا يحتاج تثبيت. غيّره فقط لو تستخدم خادماً خارجياً.
DATABASE_URL=sqlite+aiosqlite:///./rasad.db


# ─────────────────────────────────────────────────────────────────
# فواصل جمع البيانات (بالثواني) — قلّلها بحذر لتفادي حظر المزوّدين
# ─────────────────────────────────────────────────────────────────
GDELT_INTERVAL=900       # كل 15 دقيقة
NEWSAPI_INTERVAL=600     # كل 10 دقائق
RSS_INTERVAL=120         # كل دقيقتين
UCDP_INTERVAL=86400      # يومياً
ADSB_INTERVAL=30         # كل 30 ثانية (لا تنزل تحتها — حماية حصة adsb.lol)


# ─────────────────────────────────────────────────────────────────
# الخادم
# ─────────────────────────────────────────────────────────────────
# ⚠️ الافتراضي 127.0.0.1 (الجهاز المحلي فقط) — وهو الصحيح لأغلب الاستخدامات.
#    لا تغيّره إلى 0.0.0.0 إلا خلف وكيل عكسي + مصادقة: الـ API بلا حسابات
#    مستخدمين، ومن يصل إليه يقرأ كل ما جمعته.
#    داخل Docker يضبط compose المضيف تلقائياً — لا حاجة لتغييره هنا.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000


# ─────────────────────────────────────────────────────────────────
# أمن الشبكة — أصول CORS المسموح لها بمناداة الـ API (مفصولة بفواصل)
# ─────────────────────────────────────────────────────────────────
# أضِف نطاق واجهتك عند النشر، مثال:  https://username.github.io
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000


# ─────────────────────────────────────────────────────────────────
# مفتاح حماية العمليات المكلفة (/api/refresh)
# ─────────────────────────────────────────────────────────────────
# فارغ = معطّل (مناسب للتشغيل المحلي وتطبيق سطح المكتب).
# عند النشر على شبكة اضبط قيمة عشوائية طويلة، وأرسلها من العميل في الترويسة:
#   X-API-Key: <القيمة>
# توليد قيمة:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=


# ─────────────────────────────────────────────────────────────────
# حدّ المعدل لكل عنوان IP على مسارات /api (نافذة منزلقة)
# ─────────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# ثقة ترويسة X-Forwarded-For لتحديد IP العميل خلف وكيل عكسي.
# اتركها false للتشغيل المباشر (وإلا يمكن انتحال IP لتجاوز حدّ المعدل).
# فعّلها true فقط حين يكون الخادم حصراً خلف nginx موثوق (compose الإنتاجي
# يضبطها تلقائياً).
TRUST_PROXY_HEADERS=false


# ─────────────────────────────────────────────────────────────────
# سياسة الاحتفاظ بالبيانات (أيام) — تحذف الأقدم تلقائياً يومياً
# ─────────────────────────────────────────────────────────────────
RETENTION_EVENTS_DAYS=30
RETENTION_FLIGHTS_DAYS=7


# ─────────────────────────────────────────────────────────────────
# المرحلة 2 (غير مفعّلة — أزِل التعليق عند الجاهزية)
# ─────────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3-coder:30b
